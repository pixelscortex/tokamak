{
  "name": "tokamak",
  "private": true,
  "workspaces": [
    "app",
    "lab",
    "packages/build",
    "packages/sdk",
    "packages/runtime",
    "packages/ui",
    "packages/render",
    "plugins/*",
    "wiki"
  ],
  "type": "module",
  "scripts": {
    "build": "moon run app:build",
    "check": "moon run workspace:format-check workspace:lint-ts workspace:lint-rust",
    "test": "moon run :test",
    "e2e": "moon run :e2e",
    "app": "moon run app:run",
    "app:dev": "moon run app:run",
    "plugin:build": "proto run bun -- packages/build/src/build.ts",
    "ui:lab": "moon run lab:run",
    "server:start": "moon run app:server-start",
    "server:stop": "proto run bun -- packages/runtime/tools/run-app.ts stop debug",
    "server:status": "proto run bun -- packages/runtime/tools/run-app.ts status debug"
  },
  "devDependencies": {
    "@types/json-schema": "7.0.15",
    "@types/node": "26.6.6",
    "jscpd": "5.4.3",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "vite": "8.3.6"
  },
  "packageManager": "bun@1.4.4"
}
