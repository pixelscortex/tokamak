{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@tokamak/sdk": ["../packages/sdk/src/index.ts"]
    },
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "allowJs": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "run.ts",
    "feature/*.ts",
    "browser.ts",
    "chat-sandbox.ts",
    "serve.ts",
    "playwright.config.ts",
    "browser/*.ts"
  ]
}
