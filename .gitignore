
# Local tool state and generated build output stay out of source control.
.moon/cache/
.moon/docker/
.proto/
.ci-results/
target/
node_modules/
dist/

# Local investigation artifacts are not part of the product source or PR.
/spikes/

# Generated logs, renderer captures, and local code indexes are not source.
*.log
# Keep captures from pre-layout checkouts ignored as well.
/.codegraph/

# Local secrets (API keys) never leave this machine.
.env
.env.*
!.env.example

# Plugin references are regenerated before builds and checks.
/plugins/*/src/server/_generated/

# Delta app workspace state (worktrees, clones, settings) is local tooling, not source.
/.delta/

# Local HTML mock-ups and scratch renders are not source.
/.tmp/

# Test plugin references are regenerated by the fixture build.
/packages/server/tests/fixtures/record/src/server/_generated/

/app/.dev/

/app/src-tauri/gen/
