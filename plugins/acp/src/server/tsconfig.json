{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true,
    "paths": {
      "plugin:*/server": ["../../.tokamak/types/*/server.d.ts"],
      "plugin:*": ["../../.tokamak/types/*/server.d.ts"]
    }
  },
  "include": ["**/*.ts"]
}
