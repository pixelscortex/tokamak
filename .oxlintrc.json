{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./packages/ui/lint/oxlint.json"],
  "settings": {
    "shadcn": {
      "ui": "@tokamak/ui",
      "themeImports": ["^@tokamak/ui/"],
      "note": "Tokamak design rules: wiki docs/design. Tokens: @tokamak/ui/theme.css."
    }
  },
  "ignorePatterns": [
    "**/vendor/**",
    "**/dist/**",
    "**/target/**",
    "**/generated/**",
    "**/protocol.ts",
    "**/_generated/**",
    "packages/engine/tests/fixtures/array-initializer.js",
    "packages/engine/tests/fixtures/startup.js",
    "plugins/chat/src/client/**",
    "packages/ui/lint/fixtures/**"
  ],
  "rules": {
    "max-depth": ["warn", 4],
    "complexity": ["warn", 15],
    "max-lines": [
      "warn",
      {
        "max": 400,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-lines-per-function": [
      "warn",
      {
        "max": 80,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "no-unused-vars": "error",
    "no-console": "error",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-debugger": "error",
    "typescript/no-explicit-any": "warn",
    "import/no-cycle": "error"
  },
  "plugins": ["typescript", "import"],
  "overrides": [
    {
      "files": [
        "packages/build/**",
        "**/tools/**",
        "**/tests/**",
        "**/*.test.*",
        "**/*.spec.*",
        "**/scripts/**"
      ],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["packages/sdk/client.tsx"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["app/src/app.tsx", "app/src/controls.tsx"],
      "rules": {
        "shadcn/no-unknown-classes": "off"
      }
    }
  ]
}
