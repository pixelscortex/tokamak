{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/tests/**",
    "**/vendor/**",
    "**/dist/**",
    "**/target/**",
    "**/generated/**",
    "**/protocol.ts"
  ],
  "rules": {
    "max-depth": [
      "warn",
      4
    ],
    "complexity": [
      "warn",
      15
    ],
    "max-lines": [
      "warn",
      {
        "max": 400,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-lines-per-function": [
      "warn",
      {
        "max": 80,
        "skipBlankLines": true,
        "skipComments": true
      }
    ]
  }
}
